module Irb
  module Autosuggestions
    module LineEditorPatch
      RESET: String
      FAINT: String

      @autosuggest_suggestion: String?
      @autosuggest_ghost_length: Integer?
      @autosuggest_extra_count: Integer?

      def input_key: (untyped key) -> untyped

      def render: (*untyped) -> untyped
      def clear_old_ghost: -> void
      def resolve_ghost: -> (Array[String] | nil)
      def process_arrow: -> (true | nil)
      def render_ghost: (String current_ghost, Array[String] extra_lines) -> void
      def write_extra_lines: (untyped output, Array[String] lines) -> void
      def find_suggestion: (String buffer) -> (String | nil)
      def match_suggestion?: (String buffer, String suggestion) -> bool
      def line_matches?: (String buf_line, String sug_line, bool last) -> bool
      def accept_remaining: (String buffer, String remaining) -> void
      def append_lines: (Array[String] lines) -> (Array[String])
    end
  end
end
